# ─── SERVER ──────────────────────────────
PORT=3000
NODE_ENV=development

# ─── DATABASE ────────────────────────────
DATABASE_URL="postgresql://barq_user:barq_password@localhost:5432/barq_db?schema=public"

# ─── JWT ─────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# ─── RATE LIMITING ───────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
