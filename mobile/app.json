{
  "expo": {
    "name": "BARQ",
    "slug": "barq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "barq",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#040406",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barq.wellness",
      "infoPlist": {
        "NSHealthShareUsageDescription": "BARQ reads health data to track wellness.",
        "NSFaceIDUsageDescription": "BARQ uses Face ID for secure login.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.barq.wellness",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#040406"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BARQ to use Face ID."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "bf1e6702-8b96-4b26-8164-47c84250dd29"
      },
      "apiUrl": "https://interest-witch-thesis-jvc.trycloudflare.com/api/v1",
      "wsUrl": "https://interest-witch-thesis-jvc.trycloudflare.com"
    }
  }
}
